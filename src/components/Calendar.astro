---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Icon } from 'astro-icon/components';
import Event from "./Event.astro";
import { siteConfig } from "../schemas/config";
const { calendar } = siteConfig;

const futureEvents = (events: CollectionEntry<"icsCalendar">[]) => {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    return events
        .filter((event) => {
            const eventDate = new Date(event.data.start);
            return eventDate >= today;
        })
        .sort((a, b) => a.data.start.getTime() - b.data.start.getTime());
};

const events = await getCollection("icsCalendar");
const upcomingEvents = futureEvents(events);
---

<div class="mt-5 is-size-5">
    Listed locations are approximate. We will share exact locations close to the date with those who RSVP.
</div>

<hr>

<div class="grid block">
    {upcomingEvents.slice(0, 6).map((event) => <Event {event} />)}
</div>
<hr />
<div class="block">
    <div class="buttons is-centered">
    <a class="button is-primary is-outlined has-background-light" href={calendar.public}>
        <span class="icon">
          <Icon name="mdi:calendar-multiselect"/>
        </span>
        <span>See All Events</span>
    </a>
    </div>
</div>
