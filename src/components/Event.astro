---
import type { Ics } from "../schemas/config";

interface Props {
    event: {
        id: string;
        data: Ics;
    }
}

const { event } = Astro.props;

const tz = 'America/New_York'

const dateOptions = {
    year: "numeric", 
    month: "long", 
    day: "numeric", 
    timeZone: tz
} as const;

const timeOptions = {
    hour: 'numeric', 
    minute: '2-digit', 
    timeZone: tz
} as const;

const eventDetails = {
    date: event.data.start.toLocaleDateString("en-US", dateOptions),
    time: event.data.start.toLocaleTimeString("en-US", timeOptions),
    summary: event.data.summary,
    location: event.data.location,
    description: event.data.description
}
---

<div class="cell my-1" id=`event-${event.id}`>
    <div class="block">
        <p class="is-size-6">{ eventDetails.date } at { eventDetails.time }</p>
        <h2 class="title is-size-5 mb-0 has-text-weight-normal">{ eventDetails.summary }</h2>
        <span class="is-size-6 is-primary is-light">{ eventDetails.location }</span>
    </div>
</div>

<style>
    .box:last-child { 
        margin-bottom: 1.5rem;
    }
</style>